{
    "name": "el-subtitle-animator",
    "version": "1.0.0",
    "description": "El Subtitle Animator - Workflow Integration plugin for DaVinci Resolve Studio",
    "main": "main.js",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "electron .",
        "lint": "eslint .",
        "lint:py": "python3 -m pyflakes src/python tools test/python",
        "check": "eslint . && node tools/check-load-order.js && node tools/check-inspector-safe.js",
        "test": "npm run test:js && npm run test:py",
        "test:js": "node --test \"test/main/*.test.js\"",
        "test:py": "python3 -B -m unittest discover -s test/python",
        "test:update-exports": "UPDATE_EXPORTS=1 node --test test/main/contract.test.js"
    },
    "devDependencies": {
        "acorn": "^8.19.0",
        "eslint": "^9.39.5",
        "globals": "^17.14.0"
    }
}
